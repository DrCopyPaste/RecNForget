<UserControl x:Class="RecNForget.Controls.OutputPathControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RecNForget.Controls"
             mc:Ignorable="d">
    <Border Style="{DynamicResource DefaultControlBorderStyle}" HorizontalAlignment="Stretch">
        <StackPanel Orientation="Vertical">
            <DockPanel>
                <Label Style="{DynamicResource ControlLabelStyle}"
                Content="Output Path"/>
            </DockPanel>
            <DockPanel>
                <TextBox Style="{DynamicResource MainWindowTextBoxStyle}"
                Text="{Binding Path=ProjectedOutputPathIncludingFilePattern, RelativeSource={RelativeSource FindAncestor,AncestorType=local:OutputPathControl}}"
                d:Text="C:\YourPath\yourFilePattern.wav"
                ToolTip="{Binding Path=ProjectedOutputPathIncludingFilePattern, RelativeSource={RelativeSource FindAncestor,AncestorType=local:OutputPathControl}}" ToolTipService.ShowOnDisabled="True" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <local:SvgImageButton1 Style="{DynamicResource SvgChangeFilePatternMiniButtonLayout}"
                    ToolTip="change output file name pattern"
                    Command="{Binding Path=UpdateFileNamePatternCommand, RelativeSource={RelativeSource FindAncestor,AncestorType=local:OutputPathControl}}" />

                    <local:SvgImageButton1 Style="{DynamicResource SvgChangeOutputFolderMiniButtonLayout}"
                    ToolTip="change output folder"
                    Command="{Binding Path=UpdateOutputFolderCommand, RelativeSource={RelativeSource FindAncestor,AncestorType=local:OutputPathControl}}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
