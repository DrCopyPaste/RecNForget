<Window x:Class="RecNForget.Controls.NewToVersionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RecNForget.Controls"
        xmlns:svg="https://github.com/dotnetprojects/SVGImage"
        mc:Ignorable="d"
        Topmost="True"
        Style="{DynamicResource DefaultWindowStyle}"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Title="RecNForget - Things changed">
    <!-- Try to follow this node convention: (pretty much: everything that defines the grid coordinates comes first and ONLY style,
	everything that is not defined by style must not be in the opening tags starting line
	
        <NodeNme Grid.Row="0" Grid.Column="0" Grid.RowSpan="optional" Grid.ColSpan="optional" Style="{DynamicResource DefaultButtonStyle}"
            ...custom style definitions...
			...
            Name="ControlName" Visibility="optional" Click="ClickEvent" ...event definitions...
			Content/Text/Value="optional">
        </NodeName>
        -->
    <Border Style="{DynamicResource DefaultWindowBorderStyle}" MouseDown="Window_MouseDown">
        <StackPanel Orientation="Vertical">
            <local:TitleBar HorizontalAlignment="Stretch" WithMinimizeButton="True" />

            <TextBlock Style="{DynamicResource ApplicationName_TextBox_Style}"
                Text="Things changed since we last met" />

            <TextBlock Style="{DynamicResource DefaultTextBlockStyle}"
                Name="VersionInfoCaption"
                Text="Have a look at what's new!" />
            <Border Style="{DynamicResource DefaultWindowBorderStyle}" MaxHeight="300">
                <ListView ItemsSource="{Binding PatchNotes}" d:ItemsSource="{d:SampleData ItemCount=20}" BorderBrush="Transparent">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.Template>
                        <ControlTemplate>
                            <ScrollViewer>
                                <ItemsPresenter></ItemsPresenter>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListView.Template>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="Focusable" Value="False" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <svg:SVGImage x:Name="ItemName" Style="{DynamicResource AddedFeature_Image_Style}" />
                                        
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding FeatureClass}" Value="BugFix">
                                                <Setter TargetName="ItemName" Property="Style" Value="{DynamicResource BugFix_Image_Style}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FeatureClass}" Value="NewFeature">
                                                <Setter TargetName="ItemName" Property="Style" Value="{DynamicResource AddedFeature_Image_Style}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FeatureClass}" Value="Information">
                                                <Setter TargetName="ItemName" Property="Style" Value="{DynamicResource VerboseInformationFeature_Image_Style}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" Style="{DynamicResource DefaultTextBlockStyle}" ToolTip="{Binding HelpLinesAsString}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <local:SvgImageButton1 Grid.Row="11" Style="{DynamicResource SvgAcceptButton}"
                HorizontalAlignment="Right"
                ToolTip="good to know"
                Click="Exit_Click"/>
        </StackPanel>
    </Border>
</Window>
